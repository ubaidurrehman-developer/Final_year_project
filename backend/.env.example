# Copy to backend/.env and fill in real values. Never commit backend/.env.
SECRET_KEY=
DEBUG=False
# Comma-separated; defaults to localhost,127.0.0.1,192.168.1.22
ALLOWED_HOSTS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Path to the YOLO ONNX weights used by detection
MODEL_PATH=

# LLM key used by Backend/services/llm_parser.py (OpenRouter)
OPEN_ROUTER_SECRET_KEY=
